# Configuração de Ambiente — Corrida dos Candidatos
# Copie este arquivo para .env e preencha localmente (NUNCA envie .env para o Git ou chat)

# Caminho para o executável console do Godot 4.6+ usado pelo Godot Agent (gda)
GDA_GODOT=C:\\Godot\\Godot_v4.6-stable_win64_console.exe
GDA_PROJECT=C:\\Users\\Kanex\\OneDrive\\Desktop\\JOGI

# Conector Local LiveBridge (Bind exclusivo em 127.0.0.1)
LIVE_BRIDGE_HOST=127.0.0.1
LIVE_BRIDGE_PORT=8765
LIVE_BRIDGE_LOCAL_TOKEN=change_me_local_random_token
# O launcher cria credenciais efêmeras distintas para motor e coleta.
# Configuração manual exige valores distintos; nunca copie chaves reais para este arquivo.
LIVE_BRIDGE_ENGINE_TOKEN=
LIVE_BRIDGE_PRODUCER_TOKEN=
JOGI_MODE=production
JOGI_END_AT=2026-10-26T07:00:00-03:00

# Identificadores públicos das lives (opcional; testes exigem --offline/desenvolvimento separado)
TIKTOK_LIVE_UNIQUE_ID=
KWAI_LIVE_STREAM_ID=

# Tripo 3D CLI (Recomendado autenticar via `tripo.cmd login --region ov` em vez de variável)
# TRIPO_API_KEY=
# TRIPO_REGION=ov

# ElevenLabs: usar CONFIGURAR_VOZ.cmd para salvar somente em .env.local (entrada oculta).
# Nunca colocar a chave no Godot, manifesto de vozes ou argumento de terminal.
ELEVENLABS_API_KEY=
