# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.key
*.pem

# Godot 4+ Ignore
.godot/
game/.godot/
/android/
export.cfg
export_presets.cfg

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node / Playwright / Taste Skill
node_modules/
playwright-report/
test-results/
.taste-skill/

# OS & Temp files
.DS_Store
Thumbs.db
*.tmp
*.log

# Backups & Local Agent/MCP Machine State (Do not track local absolute paths)
*.backup*
*.bak
.agents/ecc-install-state.json
.agents/mcp_config.json
.agents/plugins/*/mcp_config.json

# Tripo: runtime local e relatórios de upload com tokens temporários
.tripo/
docs/*UPLOAD*.json
.tools/
